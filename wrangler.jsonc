{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "device-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static dashboard files (public/) served at root
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Durable Object = one live "room" per device holding the WebSocket connections
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_ROOM", "class_name": "DeviceRoom" },
      { "name": "REGISTRY", "class_name": "DeviceRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceRoom", "DeviceRegistry"] }
  ]

  // Secrets (set via `wrangler secret put`):
  //   RELAY_TOKEN  -> Bearer token used by the API, dashboard, and phone app
}
